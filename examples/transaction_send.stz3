staze 3
module Examples.TransactionSend

fault AllocationFailure

pool Cell
    @heap
    @lifetime(call)
    @reclaim(scope)
{
    tick: revise i32
}

public instruction main[] -> i32
faults [AllocationFailure]
{
    cell := Cell.alloc(7)
    transaction
    {
        handoff := send(cell)
    }
    return 0
}
