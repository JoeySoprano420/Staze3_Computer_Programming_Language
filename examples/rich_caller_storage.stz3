staze 3
module Examples.RichCallerStorage

dataset Pair
{
    left: i32
    right: i32
}

instruction MakePair[a: i32, b: i32] -> Pair
{
    return Pair(a, b)
}

instruction Consume[p: Pair] -> i32
{
    return 1
}

public instruction main[] -> i32
{
    item := MakePair(3, 4)
    return Consume(item)
}
