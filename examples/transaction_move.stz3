staze 3
module Examples.TxMove
fault AllocationFailure
pool Cell
    @heap
    @lifetime(scope)
    @reclaim(scope)
{
    tick: revise i32
}
public instruction main[] -> i32
faults [AllocationFailure]
{
    cell := Cell.alloc(7)
    transaction
    {
        moved := move(cell)
    }
    return 0
}
