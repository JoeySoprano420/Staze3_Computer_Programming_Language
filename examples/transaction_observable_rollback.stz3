staze 3
module Examples.TransactionObservableRollback

dataset Pair
{
    left: revise i32
    right: i32
}

instruction MutateThenFail[p: borrow_mut Pair] -> unit
faults [ArithmeticOverflow]
{
    transaction
    {
        set p.left = 99
        x: i32 := 2147483647
        y: i32 := x + 1
    }
    return
}

public instruction main[] -> i32
{
    obj: revise Pair := Pair(7, 9)
    perform MutateThenFail(borrow_mut(obj)) delete ArithmeticOverflow
    return obj.left
}
