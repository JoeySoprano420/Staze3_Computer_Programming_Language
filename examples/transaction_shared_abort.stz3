staze 3
module Examples.TransactionSharedAbort

fault AllocationFailure

pool SharedCell
    @heap
    @lifetime(call)
    @reclaim(scope)
    @ownership(shared)
{
    tick: revise i32
}

public instruction main[] -> i32
faults [AllocationFailure, ArithmeticOverflow]
{
    cell := SharedCell.alloc(3)
    transaction
    {
        other := retain(cell)
        x: i32 := 2147483647
        y: i32 := x + 1
    }
    return cell.tick
}
